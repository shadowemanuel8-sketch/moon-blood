-- ==========================================
-- FUNCAO DE ENCONTRAR BOLA — CORRIGIDA (procura em todo lugar)
-- ==========================================
local function GetBall()
    local nearestBall = nil
    local nearestDist = math.huge
    local Char = LocalPlayer.Character
    if not Char then return nil, math.huge end
    local HRP = Char:FindFirstChild("HumanoidRootPart")
    if not HRP then return nil, math.huge end

    -- Procura em TODOS os objetos, incluindo dentro de pastas
    local function SearchAll(parent)
        for _, v in ipairs(parent:GetChildren()) do
            if v:IsA("BasePart") and string.find(string.lower(v.Name), "ball") then
                local dist = (v.Position - HRP.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearestBall = v
                end
            end
            if #v:GetChildren() > 0 then
                SearchAll(v)
            end
        end
    end
    SearchAll(workspace)

    return nearestBall, nearestDist
end

-- ==========================================
-- DETECTOR DE HABILIDADES — FUNCIONAL
-- ==========================================
RunService.Heartbeat:Connect(function()
    if not State.DetectorActive then return end
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            local Char = v.Character
            if Char and Char:FindFirstChild("Humanoid") then
                local Hum = Char.Humanoid
                if not State.LastPlayerHealth[v.UserId] then
                    State.LastPlayerHealth[v.UserId] = Hum.Health
                end
                if math.abs(Hum.Health - State.LastPlayerHealth[v.UserId]) > 5 then
                    local novaEntrada = "- "..v.Name.." usou habilidade! Vida: "..math.floor(State.LastPlayerHealth[v.UserId]).." -> "..math.floor(Hum.Health)
                    State.DetectorLogText = novaEntrada.."\n"..State.DetectorLogText
                    -- Limita o texto
                    local linhas = string.split(State.DetectorLogText, "\n")
                    while #linhas > 20 do table.remove(linhas, #linhas) end
                    State.DetectorLogText = table.concat(linhas, "\n")
                    UI.DetectorLog.Text = State.DetectorLogText
                end
                State.LastPlayerHealth[v.UserId] = Hum.Health
            end
        end
    end
end)

-- ==========================================
-- LOOP PRINCIPAL — PARRY PREPARADO PARA AJUSTE
-- ==========================================
RunService.Heartbeat:Connect(function()
    -- Atualiza Status com informacao da bola
    local ball, distance = GetBall()
    if not ball then
        UI.StatusLabel.Text = "Status: Bola nao encontrada"
        UI.StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    -- Calcula velocidade
    if State.LastBallPos then
        State.BallSpeed = (ball.Position - State.LastBallPos).Magnitude
    end
    State.LastBallPos = ball.Position

    -- Atualiza texto de status
    if distance < State.ParryRange then
        UI.StatusLabel.Text = "Status: BOLA PERTO! Dist: "..math.floor(distance).." | Vel: "..math.floor(State.BallSpeed)
        UI.StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
    elseif distance < State.ParryRange * 2 then
        UI.StatusLabel.Text = "Status: Aproximando... Dist: "..math.floor(distance)
        UI.StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 70)
    else
        UI.StatusLabel.Text = "Status: Bola longa. Dist: "..math.floor(distance)
        UI.StatusLabel.TextColor3 = Color3.fromRGB(200, 140, 140)
    end

    -- EXECUCAO DE PARRY — AQUI SERA SUBSTITUIDA PELA LOGICA REAL DO BLADE BALL
    if State.AutoParry and not State.SpamUIMax and distance < State.ParryRange then
        for i = 1, State.ParryAmount do
            task.wait(0.01)
            -- TODO: Substituir pelo metodo real de parry do Blade Ball
            UIS:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.015)
