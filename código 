-- ==========================================
-- FUNCAO PEGAR BOLA E REBATER
-- ==========================================
local function GetBall()
    local nearestBall = nil
    local nearestDist = math.huge
    local Char = LocalPlayer.Character
    if not Char then return nil, math.huge end
    local HRP = Char:FindFirstChild("HumanoidRootPart")
    if not HRP then return nil, math.huge end

    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("BasePart") and string.find(string.lower(v.Name), "ball") then
            local dist = (v.Position - HRP.Position).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearestBall = v
            end
        end
    end
    return nearestBall, nearestDist
end

local function ParryBall()
    local Char = LocalPlayer.Character
    if not Char then return end
    local Hum = Char:FindFirstChildOfClass("Humanoid")
    local HRP = Char:FindFirstChild("HumanoidRootPart")
    if not Hum or not HRP or Hum.Health <= 0 then return end

    local ball, distance = GetBall()
    if not ball then return end

    -- Atualizar velocidade
    if LastBallPos then
        BallSpeed = (ball.Position - LastBallPos).Magnitude
    end
    LastBallPos = ball.Position

    -- Atualizar status
    if distance < ParryRange then
        StatusLabel.Text = "Status: BOLA PERTO - Rebatendo! Velocidade: "..math.floor(BallSpeed)
        StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
        
        -- REBATE DE VERDADE - Pressiona a tecla de parry (geralmente E ou clique)
        for i = 1, ParryAmount do
            task.wait(0.01)
            -- Simula o rebate
            UIS:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.015)
            UIS:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            
            -- Imortalidade: se mover ao rebater
            if Immortal then
                HRP.CFrame = HRP.CFrame * CFrame.new(math.random(-2, 2), 0, math.random(-2, 2))
            end
        end
    elseif distance < ParryRange * 2 then
        StatusLabel.Text = "Status: Aproximando... Distancia: "..math.floor(distance)
        StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 70)
    else
        StatusLabel.Text = "Status: Aguardando bola..."
        StatusLabel.TextColor3 = Color3.fromRGB(200, 140, 140)
    end
end

