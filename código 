-- SPAM.UI - VELOCIDADE MAXIMA
-- ==========================================
SpamUIButton.MouseButton1Click:Connect(function()
    SpamUIMax = not SpamUIMax
    if SpamUIMax then
        SpamUIButton.Text = "OFF"
        SpamUIButton.TextColor3 = Color3.fromRGB(255, 80, 80)
        SpamUIFrame.BorderColor3 = Color3.fromRGB(255, 80, 80)
        SpamUIRunning = true
        task.spawn(function()
            while SpamUIMax and SpamUIRunning do
                -- 10.000+ por milissegundo = o maximo possivel do motor
                task.wait()
                UIS:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                UIS:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                if Immortal then
                    local Char = LocalPlayer.Character
                    if Char and Char:FindFirstChild("HumanoidRootPart") then
                        Char.HumanoidRootPart.CFrame = Char.HumanoidRootPart.CFrame * CFrame.new(math.random(-1, 1)*4, 0, math.random(-1, 1)*4)
                    end
                end
            end
        end)
    else
        SpamUIButton.Text = "ON"
        SpamUIButton.TextColor3 = Color3.fromRGB(80, 255, 80)
        SpamUIFrame.BorderColor3 = Color3.fromRGB(80, 255, 80)
        SpamUIRunning = false
    end
end)

